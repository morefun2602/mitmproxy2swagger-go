# mitmproxy2swagger enrich — OpenAI / compatible API
# 用法: cp .env.example .env 后填入真实值；make example-enrich 前可 source .env

# 必填（也可通过 enrich --api-key 传入）
OPENAI_API_KEY=xxx

# 可选：OpenAI-compatible API 基址（默认 https://api.openai.com/v1）
# CLI --base-url 优先于本变量
OPENAI_BASE_URL=http://api.example.com/v1

# 可选：模型名（默认 gpt-4o-mini）
# CLI --model 优先于本变量
OPENAI_MODEL=xxx

# 可选：OpenAI 组织 / 项目（openai-go SDK 标准变量；当前 CLI 未读取，预留）
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# 调试：capture 读取器详细日志
# MITMPROXY2SWAGGER_DEBUG=1
