            "compression": 296377,
            "text": "{\"value\":[{\"product\":{\"ean\":\"3800020411162\",\"headline\":\"Kitkat peanut butter baton 42g\",\"title\":\"KITKAT\",\"subTitle\":\"Chunky peanut butter\",\"price\":2.49,\"vat\":0.00,\"isAlcohol\":false,\"verifyAge\":false,\"maxQuantity\":0,\"packInfo\":\"42g\",\"mainCategoryId\":0,\"subCategoryId\":0,\"imagePath\":\"https://res.cloudinary.com/lisek-app/image/upload/Products/3800020411162_7_Production.png\",\"imagePathLastComponent\":\"3800020411162_7_Production.png\",\"isHit\":false,\"isPromo\":false,\"isNew\":false,\"isCold\":false,\"isBundle\":false,\"dimensions\":\"{\\\"height\\\":43,\\\"width\\\":142,\\\"depth\\\":17}\",\"information\":\"\\n<p><strong class=\\\"itemHeader\\\">Marka</strong></p>\\n<p><span>Kitkat</span></p>\\n<p id=\\\"nameLookupType_33\\\"><strong class=\\\"itemHeader\\\">Marka standaryzowana</strong></p>\\n<p id=\\\"nameLookupValue_33\\\"><span>Marka - KitKat</span><br></p>\\n<p><strong class=\\\"itemHeader\\\">Nazwa produktu uregulowana prawnie</strong></p>\\n<p>Paluszek waflowy pokryty kremem arachidowym (19 %), w mlecznej czekoladzie (61,8 %).</p>\\n\",\"ingredients\":\"\\n<p><strong class=\\\"itemHeader\\\">Składniki</strong></p>\\n<p class=\\\"embedded\\\">cukier</p>\\n<p class=\\\"embedded\\\">odtłuszczona <span style='font-weight: bold;'>MLEKO</span> w proszku</p>\\n<p class=\\\"embedded\\\">mąka <span style='font-weight: bold;'>PSZENNA</span></p>\\n<p class=\\\"embedded\\\">pasta z <span style='font-weight: bold;'>ORZECHÓW ARACHIDOWYCH</span> (10,1 %)</p>\\n<p class=\\\"embedded\\\">miazga kakaowa</p>\\n<p class=\\\"embedded\\\">tłuszcze roślinne (palmowy, shea)</p>\\n<p class=\\\"embedded\\\">tłuszcz kakaowy</p>\\n<p class=\\\"embedded\\\">tłuszcz <span style='font-weight: bold;'>MLECZNY</span></p>\\n<p class=\\\"embedded\\\">preparat serwatkowy w proszku (z <span style='font-weight: bold;'>MLEKA</span>)</p>\\n<p class=\\\"embedded\\\">mąka <span style='font-weight: bold;'>ARACHIDOWA</span> (1,9 %)</p>\\n<p cl